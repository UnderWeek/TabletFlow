import { ScrollView, Palette } from "std-widgets.slint";

export global AppTheme {
    in-out property <string> mode: "system";
    in-out property <string> accent: "Blue";
    in-out property <bool> compact: false;
    in-out property <bool> reduce-motion: false;
    in-out property <bool> custom-colors: false;
    in-out property <float> custom-background-hue: 212;
    in-out property <float> custom-background-saturation: 0.10;
    in-out property <float> custom-background-value: 0.96;
    in-out property <float> custom-accent-hue: 212;
    in-out property <float> custom-accent-saturation: 0.42;
    in-out property <float> custom-accent-value: 0.86;

    out property <bool> light: mode == "light" || (mode == "system" && Palette.color-scheme == ColorScheme.light);
    out property <color> custom-background-color: Colors.hsv(custom-background-hue, custom-background-saturation, custom-background-value);
    out property <color> custom-accent-color: Colors.hsv(custom-accent-hue, custom-accent-saturation, custom-accent-value);
    out property <bool> custom-background-light: custom-background-color.red * 0.299 + custom-background-color.green * 0.587 + custom-background-color.blue * 0.114 > 145;
    out property <bool> custom-accent-light: custom-accent-color.red * 0.299 + custom-accent-color.green * 0.587 + custom-accent-color.blue * 0.114 > 145;
    out property <bool> effective-light: custom-colors ? custom-background-light : light;
    // One cool-neutral design system keeps light and dark mode visually related.
    out property <color> canvas: custom-colors ? custom-background-color : (light ? #f3f5f7 : #0d1116);
    out property <color> sidebar: custom-colors ? (effective-light ? custom-background-color.darker(0.05) : custom-background-color.brighter(0.06)) : (light ? #e9edf1 : #12171d);
    out property <color> surface: custom-colors ? (effective-light ? custom-background-color.brighter(0.05) : custom-background-color.brighter(0.10)) : (light ? #fbfcfd : #171d24);
    out property <color> surface-raised: custom-colors ? (effective-light ? custom-background-color.brighter(0.10) : custom-background-color.brighter(0.15)) : (light ? #ffffff : #1c232c);
    out property <color> surface-alt: custom-colors ? (effective-light ? custom-background-color.darker(0.04) : custom-background-color.brighter(0.20)) : (light ? #edf1f4 : #202832);
    out property <color> surface-shell: custom-colors ? (effective-light ? custom-background-color.darker(0.10) : custom-background-color.darker(0.16)) : (light ? #dfe5ea : #0a0e12);
    out property <color> line: custom-colors ? (effective-light ? custom-accent-color.with-alpha(0.14) : custom-accent-color.with-alpha(0.20)) : (light ? #2437481a : #e7f0fa18);
    out property <color> line-strong: custom-colors ? (effective-light ? custom-accent-color.with-alpha(0.28) : custom-accent-color.with-alpha(0.34)) : (light ? #2437482e : #e7f0fa2e);
    out property <color> text: custom-colors ? (effective-light ? #15202a : #f2f5f8) : (light ? #17222c : #f2f5f8);
    out property <color> text-secondary: custom-colors ? (effective-light ? #334551 : #d7dee6) : (light ? #3f4f5d : #d7dee6);
    out property <color> text-muted: custom-colors ? (effective-light ? #586b78 : #a2adb8) : (light ? #61727f : #929eaa);
    out property <color> icon: custom-colors ? (effective-light ? #506473 : #adbac6) : (light ? #596a78 : #a9b4c0);
    out property <color> hover: custom-colors ? (effective-light ? custom-accent-color.with-alpha(0.10) : custom-accent-color.with-alpha(0.16)) : (light ? #dfe6ec : #222a33);
    out property <color> pressed: custom-colors ? (effective-light ? custom-accent-color.with-alpha(0.16) : custom-accent-color.with-alpha(0.24)) : (light ? #d4dde5 : #2a343f);
    out property <color> shadow: custom-colors ? (effective-light ? custom-background-color.darker(0.30).with-alpha(0.14) : #02070d80) : (light ? #20364f20 : #02070d80);
    out property <color> success: effective-light ? #39735d : #86bda8;
    out property <color> success-soft: effective-light ? #dcebe5 : #1f382f;
    out property <color> warning: effective-light ? #8a622d : #d1a56b;
    out property <color> danger: effective-light ? #9a4d50 : #e1969a;
    out property <color> danger-soft: effective-light ? #f3e3e4 : #3d2529;
    out property <color> scrim: effective-light ? #1524335e : #00050a99;
    out property <color> accent-color: custom-colors ? custom-accent-color : (accent == "Amber" ? (light ? #8a642f : #d2a86f) : (accent == "Mint" ? (light ? #3f7b64 : #91c3ac) : (light ? #456f9b : #8eb4df)));
    out property <color> accent-soft: custom-colors ? (effective-light ? custom-accent-color.with-alpha(0.16) : custom-accent-color.with-alpha(0.24)) : (accent == "Amber" ? (light ? #eee3d3 : #3b3225) : (accent == "Mint" ? (light ? #dcebe4 : #233a32) : (light ? #dce7f2 : #25364a)));
    out property <color> accent-pressed: custom-colors ? (effective-light ? custom-accent-color.darker(0.16) : custom-accent-color.brighter(0.10)) : (accent == "Amber" ? (light ? #735126 : #ad824c) : (accent == "Mint" ? (light ? #32624f : #6f9f8b) : (light ? #36597d : #7195bf)));
    out property <color> accent-on: custom-colors ? (custom-accent-light ? #10171f : #ffffff) : (effective-light ? #ffffff : #10171f);
    out property <brush> hero-fill: custom-colors
        ? (effective-light
            ? @linear-gradient(135deg, custom-background-color.brighter(0.16) 0%, custom-background-color.brighter(0.04) 100%)
            : @linear-gradient(135deg, custom-background-color.brighter(0.18) 0%, custom-background-color.brighter(0.07) 100%))
        : (effective-light
            ? @linear-gradient(135deg, #ffffff 0%, #e8eff5 100%)
            : @linear-gradient(135deg, #1d252e 0%, #172536 100%));

    out property <length> row-height: compact ? 44px : 50px;
    out property <length> nav-height: compact ? 38px : 42px;
    out property <length> button-height: compact ? 40px : 44px;
}

// Geometry-based icons keep the UI independent from font glyph coverage.
// They are intentionally small and quiet, but each one has a distinct silhouette.
component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: AppTheme.icon;

    width: 18px;
    height: 18px;
    background: transparent;

    if root.name == "area" || root.name == "tablet": Rectangle {
        x: 1px;
        y: 3px;
        width: 16px;
        height: 12px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 3px;
    }
    if root.name == "area" || root.name == "tablet": Rectangle {
        x: 4px;
        y: 6px;
        width: 10px;
        height: 6px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 1px;
    }
    if root.name == "pen": Rectangle {
        x: 7px;
        y: 1px;
        width: 4px;
        height: 12px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "pen": Rectangle {
        x: 6px;
        y: 12px;
        width: 6px;
        height: 4px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 1px;
        y: 6px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 11px;
        y: 6px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 6px;
        y: 1px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 6px;
        y: 11px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "profiles": Rectangle {
        x: 6px;
        y: 2px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.tint;
    }
    if root.name == "profiles": Rectangle {
        x: 3px;
