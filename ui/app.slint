}

component SettingsPage inherits Rectangle {
    in property <string> backend-state;
    in-out property <string> theme: "System";
    in-out property <string> accent: "Lavender";
    in-out property <bool> compact-ui: false;
    in-out property <bool> reduce-animations: false;
    in-out property <bool> start-with-system: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> minimize-to-tray: false;
    in-out property <bool> close-to-tray: false;
    in-out property <bool> check-updates: true;
    in-out property <bool> pause-hidden: true;
    in-out property <bool> disable-unfocused-animations: false;
    in-out property <string> polling-interval: "Auto";
    in-out property <bool> low-power-mode: false;
    in-out property <bool> show-diagnostics: false;

    background: #111318;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: 1290px;

        HorizontalLayout {
            width: parent.width;
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                width: parent.width < 760px ? parent.width : 760px;
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 27px;
                padding-bottom: 30px;
                spacing: 2px;

            PageHeader { icon: "settings"; title: "Settings"; subtitle: "TabletFlow"; }

            Rectangle { height: 13px; }
            SectionHeader { icon: "theme"; title: "Appearance"; hint: ""; }
            HorizontalLayout {
                height: 49px;
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;
                Icon { name: "theme"; tint: #9299aa; width: 20px; height: 20px; }
                Text { text: "Theme"; color: #d8d9e3; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                SegmentButton { label: "System"; selected: root.theme == "System"; clicked => { root.theme = "System"; } }
                SegmentButton { label: "Light"; selected: root.theme == "Light"; clicked => { root.theme = "Light"; } }
                SegmentButton { label: "Dark"; selected: root.theme == "Dark"; clicked => { root.theme = "Dark"; } }
            }
            HorizontalLayout {
                height: 49px;
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;
                Icon { name: "accent"; tint: #9299aa; width: 20px; height: 20px; }
                Text { text: "Accent color"; color: #d8d9e3; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                ColorOption { swatch: #c9c5ff; selected: root.accent == "Lavender"; clicked => { root.accent = "Lavender"; } }
                ColorOption { swatch: #9cc9ff; selected: root.accent == "Blue"; clicked => { root.accent = "Blue"; } }
                ColorOption { swatch: #9ad5bd; selected: root.accent == "Mint"; clicked => { root.accent = "Mint"; } }
            }
            Divider {}
            SwitchRow { icon: "compact"; label: "Compact UI"; description: "Use tighter spacing throughout TabletFlow"; checked: root.compact-ui; toggled => { root.compact-ui = !root.compact-ui; } }
            SwitchRow { icon: "reduce"; label: "Reduce animations"; description: "Prefer instant transitions"; checked: root.reduce-animations; toggled => { root.reduce-animations = !root.reduce-animations; } }

            Rectangle { height: 17px; }
            SectionHeader { icon: "general"; title: "General"; hint: ""; }
            SwitchRow { icon: "startup"; label: "Start with system"; checked: root.start-with-system; toggled => { root.start-with-system = !root.start-with-system; } }
            SwitchRow { icon: "minimized"; label: "Start minimized"; checked: root.start-minimized; toggled => { root.start-minimized = !root.start-minimized; } }
            SwitchRow { icon: "tray"; label: "Minimize to tray"; checked: root.minimize-to-tray; toggled => { root.minimize-to-tray = !root.minimize-to-tray; } }
            SwitchRow { icon: "close"; label: "Close to tray"; checked: root.close-to-tray; toggled => { root.close-to-tray = !root.close-to-tray; } }
            SwitchRow { icon: "updates"; label: "Check for updates"; checked: root.check-updates; toggled => { root.check-updates = !root.check-updates; } }

            Rectangle { height: 17px; }
            SectionHeader { icon: "plugins"; title: "OpenTabletDriver"; hint: "Not available yet"; }
            ValueRow { icon: "daemon"; label: "Daemon path"; value: "Not configured"; enabled: false; }
            Divider {}
            SwitchRow { icon: "detect"; label: "Auto-detect daemon"; checked: false; enabled: false; }
            SwitchRow { icon: "start-daemon"; label: "Start daemon with TabletFlow"; checked: false; enabled: false; }
            ValueRow { icon: "restart"; label: "Restart daemon"; value: "Not available yet"; enabled: false; }
            ValueRow {
                icon: "connection";
                label: "Connection status";
                value: root.backend-state == "unknown" ? "—" : (root.backend-state == "daemon-not-running" ? "Not running" : (root.backend-state == "daemon-starting" ? "Starting" : (root.backend-state == "daemon-running" ? "Waiting for tablet" : (root.backend-state == "no-tablet" ? "No tablet" : "Connected"))));
                enabled: false;
            }

            Rectangle { height: 17px; }
            SectionHeader { icon: "performance"; title: "Performance"; hint: ""; }
            SwitchRow { icon: "pause"; label: "Pause UI updates when hidden"; checked: root.pause-hidden; toggled => { root.pause-hidden = !root.pause-hidden; } }
            SwitchRow { icon: "focus"; label: "Disable animations when unfocused"; checked: root.disable-unfocused-animations; toggled => { root.disable-unfocused-animations = !root.disable-unfocused-animations; } }
            HorizontalLayout {
                height: 49px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                cross-axis-alignment: center;
                Icon { name: "polling"; tint: #9299aa; width: 20px; height: 20px; }
                Text { text: "Background polling interval"; color: #d8d9e3; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                SegmentButton { label: "Auto"; selected: root.polling-interval == "Auto"; clicked => { root.polling-interval = "Auto"; } }
                SegmentButton { label: "Low"; selected: root.polling-interval == "Low"; clicked => { root.polling-interval = "Low"; } }
                SegmentButton { label: "High"; selected: root.polling-interval == "High"; clicked => { root.polling-interval = "High"; } }
            }
            SwitchRow { icon: "power"; label: "Low power mode"; checked: root.low-power-mode; toggled => { root.low-power-mode = !root.low-power-mode; } }

            Rectangle { height: 17px; }
            SectionHeader { icon: "advanced"; title: "Advanced"; hint: ""; }
            SwitchRow { icon: "diagnostics"; label: "Show diagnostics"; checked: root.show-diagnostics; toggled => { root.show-diagnostics = !root.show-diagnostics; } }
            ValueRow { icon: "config"; label: "Open config directory"; value: "Not available yet"; enabled: false; }
            ValueRow {
                icon: "reset";
                label: "Reset TabletFlow settings";
                value: "Reset";
                enabled: true;
                interactive: true;
                show-chevron: true;
                clicked => {
                    root.theme = "System";
                    root.accent = "Lavender";
                    root.compact-ui = false;
                    root.reduce-animations = false;
                    root.start-with-system = false;
                    root.start-minimized = false;
                    root.minimize-to-tray = false;
                    root.close-to-tray = false;
                    root.check-updates = true;
                    root.pause-hidden = true;
                    root.disable-unfocused-animations = false;
                    root.polling-interval = "Auto";
                    root.low-power-mode = false;
                    root.show-diagnostics = false;
                }
            }

            Rectangle { height: 20px; }
            Divider {}
                HorizontalLayout {
                    height: 38px;
                    padding-left: 12px;
                    padding-right: 12px;
                    Text { text: "TabletFlow 0.1.0"; color: #7e8597; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: "OpenTabletDriver —"; color: #7e8597; font-size: 11px; vertical-alignment: center; }
                    Text { text: "GitHub"; color: #aaa5e5; font-size: 11px; vertical-alignment: center; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

component SectionPage inherits Rectangle {
    in property <string> page-title;
    in property <string> message;

    background: #111318;
    VerticalLayout {
        padding-left: 34px;
        padding-right: 34px;
        padding-top: 27px;
        padding-bottom: 27px;
        spacing: 12px;
        PageHeader { icon: root.page-title == "Bindings" ? "buttons" : ""; title: root.page-title; subtitle: ""; }
        if root.message != "": Text {
            text: root.message;
            color: #9298aa;
            font-size: 13px;
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// Backend state contract: "unknown", "daemon-not-running", "no-tablet", "ready".
// The default stays unknown until real IPC data is provided by the backend.
export component MainWindow inherits Window {
    title: "TabletFlow";
    preferred-width: 960px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 500px;

    in-out property <string> active-page: "Overview";
    in-out property <string> backend-state: "unknown";
    in-out property <string> device-name: "";
    in-out property <string> active-profile: "";
    in-out property <string> area-width: "";
    in-out property <string> area-height: "";
    in-out property <string> area-x: "";
    in-out property <string> area-y: "";
    in-out property <string> area-rotation: "";
    in-out property <bool> pen-data-available: false;
    in-out property <string> theme: "System";
    in-out property <string> accent: "Lavender";
    in-out property <bool> compact-ui: false;
    in-out property <bool> reduce-animations: false;
    in-out property <bool> start-with-system: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> minimize-to-tray: false;
    in-out property <bool> close-to-tray: false;
    in-out property <bool> check-updates: true;
    in-out property <bool> pause-hidden: true;
    in-out property <bool> disable-unfocused-animations: false;
    in-out property <string> polling-interval: "Auto";
    in-out property <bool> low-power-mode: false;
    in-out property <bool> show-diagnostics: false;

    callback navigate(string);
    callback start-daemon();
    callback retry-backend();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111318;

        HorizontalLayout {
            spacing: 0px;
            Sidebar {
                active-page: root.active-page;
                navigate(page) => { root.navigate(page); }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #111318;

                if root.active-page == "Overview" && root.backend-state == "daemon-not-running": EmptyState {
                    heading: "TabletFlow";
                    message: "OpenTabletDriver is not running";
                    detail: "";
                    primary-label: "Start daemon";
                    secondary-label: "Retry";
                    primary-clicked => { root.start-daemon(); }
                    secondary-clicked => { root.retry-backend(); }
                }
                if root.active-page == "Overview" && root.backend-state == "no-tablet": EmptyState {
                    heading: "TabletFlow";
                    message: "No tablet detected";
                    detail: "Connect a supported tablet.";
                    primary-label: "";
                    secondary-label: "Retry";
                    secondary-clicked => { root.retry-backend(); }
                }
                if root.active-page == "Overview" && root.backend-state == "daemon-starting": EmptyState {
                    heading: "TabletFlow";
                    message: "Starting OpenTabletDriver";
                    detail: "Retry in a moment.";
                    primary-label: "";
                    secondary-label: "Retry";
                    secondary-clicked => { root.retry-backend(); }
                }
                if root.active-page == "Overview" && root.backend-state == "ready" && root.device-name != "": DeviceOverview {
                    device-name: root.device-name;
                    active-profile: root.active-profile;
                    configure-area => { root.navigate("Area"); }
                    open-pen => { root.navigate("Pen"); }
                    open-bindings => { root.navigate("Bindings"); }
                }
                if root.active-page == "Overview"
                    && (root.backend-state == "unknown"
                        || root.backend-state == "daemon-running"
                        || (root.backend-state == "ready" && root.device-name == "")): EmptyState {
                    heading: "TabletFlow";
                    message: root.backend-state == "daemon-running" ? "Waiting for tablet detection" : "Waiting for OpenTabletDriver";
                    detail: root.backend-state == "daemon-running" ? "Connect a supported tablet." : "Connect OpenTabletDriver to continue.";
                    primary-label: "";
                    secondary-label: "Retry";
                    secondary-clicked => { root.retry-backend(); }
                }

                if root.active-page == "Area": AreaPage {
                    backend-state: root.backend-state;
                    device-name: root.device-name;
                    area-width: root.area-width;
                    area-height: root.area-height;
                    area-x: root.area-x;
                    area-y: root.area-y;
                    area-rotation: root.area-rotation;
                    retry-detection => { root.retry-backend(); }
                }
                if root.active-page == "Pen": PenPage {
                    backend-state: root.backend-state;
                    device-name: root.device-name;
                    pen-data-available: root.pen-data-available;
                    retry-detection => { root.retry-backend(); }
                }
                if root.active-page == "Plugins": PluginsPage {}
                if root.active-page == "Profiles": ProfilesPage {}
                if root.active-page == "Settings": SettingsPage {
                    backend-state: root.backend-state;
                    theme <=> root.theme;
                    accent <=> root.accent;
                    compact-ui <=> root.compact-ui;
                    reduce-animations <=> root.reduce-animations;
                    start-with-system <=> root.start-with-system;
                    start-minimized <=> root.start-minimized;
                    minimize-to-tray <=> root.minimize-to-tray;
                    close-to-tray <=> root.close-to-tray;
                    check-updates <=> root.check-updates;
                    pause-hidden <=> root.pause-hidden;
                    disable-unfocused-animations <=> root.disable-unfocused-animations;
                    polling-interval <=> root.polling-interval;
                    low-power-mode <=> root.low-power-mode;
                    show-diagnostics <=> root.show-diagnostics;
                }
                if root.active-page == "Bindings": SectionPage {
                    page-title: "Bindings";
                    message: root.backend-state == "unknown" ? "" : (root.backend-state == "daemon-not-running" ? "OpenTabletDriver is not running" : (root.backend-state == "daemon-running" ? "Waiting for tablet detection" : (root.backend-state == "no-tablet" ? "Connect a tablet to continue." : "")));
                }
            }
        }
    }
}
