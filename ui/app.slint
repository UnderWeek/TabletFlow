component PenEditor inherits Rectangle {
    in property <string> device-name;
    in property <bool> enabled;
    property <bool> disable-pressure: false;
    callback retry-detection();

    background: AppTheme.canvas;
    VerticalLayout {
        padding-left: 34px;
        padding-right: 34px;
        padding-top: 27px;
        padding-bottom: 27px;
        spacing: 17px;

        PageHeader { icon: "pen"; title: "Pen"; subtitle: root.device-name; }

        HorizontalLayout {
            spacing: 20px;
            vertical-stretch: 1;
            Rectangle {
                horizontal-stretch: 3;
                VerticalLayout {
                    spacing: 3px;
                    SectionHeader { icon: "test"; title: "Pressure curve"; hint: root.enabled ? "" : "Not available yet"; }
                    PressureCurvePreview { enabled: root.enabled; }
                    SectionHeader { icon: "test"; title: "Test pressure area"; hint: ""; }
                    PressureTestArea { enabled: root.enabled; }
                }
            }
            Rectangle {
                horizontal-stretch: 2;
                VerticalLayout {
                    spacing: 3px;
                    SectionHeader { icon: "sensitivity"; title: "Sensitivity"; hint: root.enabled ? "" : "Not available yet"; }
                    ValueRow { icon: "sensitivity"; label: "Tip sensitivity"; value: "-"; enabled: root.enabled; }
                    Divider {}
                    SwitchRow {
                        icon: "disable-pressure";
                        label: "Disable pressure";
                        description: "Use a constant stroke width";
                        checked: root.disable-pressure;
                        enabled: root.enabled;
                        toggled => { root.disable-pressure = !root.disable-pressure; }
                    }
                    Rectangle { height: 11px; }
                    SectionHeader { icon: "buttons"; title: "Pen button bindings"; hint: ""; }
                    ValueRow { icon: "button1"; label: "Button 1"; value: "-"; enabled: root.enabled; }
                    Divider {}
                    ValueRow { icon: "button2"; label: "Button 2"; value: "-"; enabled: root.enabled; }
                    if !root.enabled: AvailabilityHint {}
                    Rectangle { vertical-stretch: 1; }
                    AppButton {
                        label: "Retry detection";
                        primary: false;
                        enabled: true;
                        clicked => { root.retry-detection(); }
                    }
                }
            }
        }
    }
}

component PenPage inherits Rectangle {
    in property <string> backend-state;
    in property <string> device-name;
    in property <bool> pen-data-available;
    callback retry-detection();

    if root.backend-state == "ready" && root.device-name != "": PenEditor {
        device-name: root.device-name;
        enabled: root.pen-data-available;
        retry-detection => { root.retry-detection(); }
    }
    if root.backend-state != "ready" || root.device-name == "": EmptyState {
        icon: "pen";
        centered: false;
        heading: "Pen";
        message: root.backend-state == "daemon-not-running" ? "OpenTabletDriver is not running" : (root.backend-state == "daemon-starting" ? "Starting OpenTabletDriver" : (root.backend-state == "daemon-running" ? "Waiting for tablet detection" : (root.backend-state == "unknown" ? "Waiting for tablet detection" : "No tablet connected")));
        detail: root.backend-state == "daemon-not-running" ? "Start OpenTabletDriver to detect a tablet." : (root.backend-state == "daemon-starting" ? "Retry in a moment." : "Connect a tablet to configure the pen.");
        primary-label: "";
        secondary-label: "Retry detection";
        secondary-clicked => { root.retry-detection(); }
    }
}

component PluginsPage inherits Rectangle {
