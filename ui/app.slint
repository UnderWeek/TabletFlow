import { ScrollView, Palette } from "std-widgets.slint";

export global AppTheme {
    in-out property <string> mode: "system";
    in-out property <string> accent: "Blue";
    in-out property <bool> compact: false;
    in-out property <bool> reduce-motion: false;

    out property <bool> light: mode == "light" || (mode == "system" && Palette.color-scheme == ColorScheme.light);
    out property <color> canvas: light ? #f5f7fa : #111418;
    out property <color> sidebar: light ? #edf1f5 : #171b20;
    out property <color> surface: light ? #ffffff : #181d23;
    out property <color> surface-alt: light ? #e9eef3 : #202830;
    out property <color> line: light ? #d6dee6 : #2a323b;
    out property <color> text: light ? #17212b : #eef3f8;
    out property <color> text-secondary: light ? #435260 : #dbe3eb;
    out property <color> text-muted: light ? #667582 : #8997a6;
    out property <color> icon: light ? #5d6c79 : #a8b1bd;
    out property <color> accent-color: accent == "Amber" ? (light ? #8b642e : #d6aa72) : (accent == "Mint" ? (light ? #3f8066 : #9ac7b0) : (light ? #426f9e : #8fb5e6));
    out property <color> accent-soft: accent == "Amber" ? (light ? #f1e5d2 : #3f3526) : (accent == "Mint" ? (light ? #dcefe6 : #273d36) : (light ? #dce9f7 : #27384d));
    out property <color> accent-pressed: accent == "Amber" ? (light ? #745226 : #a47742) : (accent == "Mint" ? (light ? #326650 : #6c9f88) : (light ? #355b83 : #7398c8));
    out property <color> accent-on: light ? #ffffff : #101820;

    out property <length> row-height: compact ? 43px : 49px;
    out property <length> nav-height: compact ? 34px : 36px;
    out property <length> button-height: compact ? 34px : 38px;
}

// Geometry-based icons keep the UI independent from font glyph coverage.
// They are intentionally small and quiet, but each one has a distinct silhouette.
component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: AppTheme.icon;

    width: 18px;
    height: 18px;
    background: transparent;

    if root.name == "area" || root.name == "tablet": Rectangle {
        x: 1px;
        y: 3px;
        width: 16px;
        height: 12px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 3px;
    }
    if root.name == "area" || root.name == "tablet": Rectangle {
        x: 4px;
        y: 6px;
        width: 10px;
        height: 6px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 1px;
    }
    if root.name == "pen": Rectangle {
        x: 7px;
        y: 1px;
        width: 4px;
        height: 12px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "pen": Rectangle {
        x: 6px;
        y: 12px;
        width: 6px;
        height: 4px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 1px;
        y: 6px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 11px;
        y: 6px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 6px;
        y: 1px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "plugins": Rectangle {
        x: 6px;
        y: 11px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "profiles": Rectangle {
        x: 6px;
        y: 2px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.tint;
    }
    if root.name == "profiles": Rectangle {
        x: 3px;
        y: 9px;
        width: 12px;
        height: 7px;
        border-radius: 4px;
        background: root.tint;
    }
    if root.name == "settings" || root.name == "advanced": Rectangle {
        x: 7px;
        y: 1px;
        width: 4px;
        height: 16px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "settings" || root.name == "advanced": Rectangle {
        x: 1px;
        y: 7px;
        width: 16px;
        height: 4px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "settings" || root.name == "advanced": Rectangle {
        x: 4px;
        y: 4px;
        width: 10px;
        height: 10px;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.tint;
        background: transparent;
    }
    if root.name == "logo": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.tint;
    }
    if root.name == "logo": Rectangle {
        x: 7px;
        y: 7px;
        width: 4px;
        height: 4px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "theme" || root.name == "connection": Rectangle {
        x: 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 8px;
        border-width: 2px;
        border-color: root.tint;
    }
    if root.name == "accent": Rectangle {
        x: 4px;
        y: 4px;
        width: 10px;
        height: 10px;
        border-radius: 6px;
        background: root.tint;
    }
    if root.name == "compact" || root.name == "performance": Rectangle {
        x: 2px;
        y: 3px;
        width: 14px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "compact" || root.name == "performance": Rectangle {
        x: 2px;
        y: 8px;
        width: 10px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "compact" || root.name == "performance": Rectangle {
        x: 2px;
        y: 13px;
        width: 6px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "startup" || root.name == "minimized" || root.name == "tray": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 2px;
    }
    if root.name == "startup" || root.name == "minimized" || root.name == "tray": Rectangle {
        x: 7px;
        y: 7px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "close": Rectangle {
        x: 3px;
        y: 8px;
        width: 12px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "close": Rectangle {
        x: 8px;
        y: 3px;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "updates" || root.name == "restart" || root.name == "reset": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 7px;
        border-width: 2px;
        border-color: root.tint;
        background: transparent;
    }
    if root.name == "daemon" || root.name == "config" || root.name == "detect": Rectangle {
        x: 3px;
        y: 5px;
        width: 12px;
        height: 9px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 2px;
    }
    if root.name == "daemon" || root.name == "config" || root.name == "detect": Rectangle {
        x: 5px;
        y: 7px;
        width: 2px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "daemon" || root.name == "config" || root.name == "detect": Rectangle {
        x: 9px;
        y: 7px;
        width: 2px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "start-daemon" || root.name == "pause": Rectangle {
        x: 4px;
        y: 3px;
        width: 3px;
        height: 12px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "start-daemon" || root.name == "pause": Rectangle {
        x: 11px;
        y: 3px;
        width: 3px;
        height: 12px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "width" || root.name == "height" || root.name == "x" || root.name == "y" || root.name == "rotation" || root.name == "lock" || root.name == "sensitivity" || root.name == "disable-pressure" || root.name == "buttons" || root.name == "button1" || root.name == "button2" || root.name == "test" || root.name == "polling" || root.name == "power" || root.name == "diagnostics": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.tint;
    }
    if root.name == "buttons" || root.name == "button1" || root.name == "button2": Rectangle {
        x: 6px;
        y: 6px;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: root.tint;
    }
    if root.name == "test": Rectangle {
        x: 2px;
        y: 8px;
        width: 14px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "test": Rectangle {
        x: 8px;
        y: 3px;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "home" || root.name == "general": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-width: 1px;
        border-color: root.tint;
        border-radius: 2px;
    }
    if root.name == "home" || root.name == "general": Rectangle {
        x: 7px;
        y: 9px;
        width: 4px;
        height: 6px;
        background: root.tint;
    }
    if root.name == "reduce" || root.name == "focus": Rectangle {
        x: 3px;
        y: 8px;
        width: 12px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "reduce" || root.name == "focus": Rectangle {
        x: 4px;
        y: 4px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.tint;
    }
}

component AppButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: AppTheme.button-height;
    width: root.primary ? 132px : 104px;
    opacity: root.enabled ? (touch.pressed ? 0.88 : 1.0) : 0.42;
    border-radius: 19px;
    background: root.primary ? (touch.pressed ? AppTheme.accent-pressed : AppTheme.accent-color) : (touch.pressed ? #303842 : (touch.has-hover ? #252c35 : AppTheme.surface));
    border-width: root.primary ? 0px : 1px;
    border-color: AppTheme.line;

    Text {
        text: root.label;
        color: root.primary ? AppTheme.accent-on : AppTheme.text-secondary;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: AppTheme.nav-height;
    border-radius: 10px;
    background: root.selected ? (touch.pressed ? AppTheme.accent-pressed : AppTheme.accent-soft) : (touch.pressed ? #29313a : (touch.has-hover ? #20262d : transparent));

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 10px;
        cross-axis-alignment: center;
        Icon {
            name: root.icon;
            tint: root.selected ? AppTheme.accent-color : (touch.pressed ? #cbd4df : AppTheme.icon);
            width: 18px;
        }
        Text {
            text: root.label;
            color: root.selected ? AppTheme.text : #b8c1cc;
            font-size: 13px;
            font-weight: root.selected ? 650 : 450;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Sidebar inherits Rectangle {
    in property <string> active-page;
    callback navigate(string);

    width: 196px;
    background: AppTheme.sidebar;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 17px;
        padding-bottom: 17px;
        spacing: 4px;

        Rectangle {
            height: 37px;
            border-radius: 9px;
            background: touch.pressed ? #27303a : (touch.has-hover ? #20262d : transparent);
            HorizontalLayout {
                padding-left: 8px;
                spacing: 9px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 8px;
                    background: AppTheme.accent-color;
                    Icon {
                        name: "logo";
                        tint: AppTheme.accent-on;
                        x: 3px;
                        y: 3px;
                    }
                }
                Text {
                    text: "TabletFlow";
                    color: AppTheme.text;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                clicked => { root.navigate("Overview"); }
            }
        }

        Rectangle { height: 18px; }

        NavItem {
            icon: "area";
            label: "Area";
            selected: root.active-page == "Area";
            clicked => { root.navigate("Area"); }
        }
        NavItem {
            icon: "pen";
            label: "Pen";
            selected: root.active-page == "Pen";
            clicked => { root.navigate("Pen"); }
        }
        NavItem {
            icon: "plugins";
            label: "Plugins";
            selected: root.active-page == "Plugins";
            clicked => { root.navigate("Plugins"); }
        }
        NavItem {
            icon: "profiles";
            label: "Profiles";
            selected: root.active-page == "Profiles";
            clicked => { root.navigate("Profiles"); }
        }
        NavItem {
            icon: "settings";
            label: "Settings";
            selected: root.active-page == "Settings";
            clicked => { root.navigate("Settings"); }
        }

        Rectangle { vertical-stretch: 1; }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: AppTheme.line;
    }
}

component PageHeader inherits Rectangle {
    in property <string> icon: "";
    in property <string> title;
    in property <string> subtitle;

    height: AppTheme.compact ? 62px : 68px;
    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;
        if root.icon != "": Rectangle {
            width: 28px;
            height: 28px;
            background: transparent;
            Icon {
                name: root.icon;
                tint: AppTheme.accent-color;
                x: 5px;
                y: 5px;
            }
        }
        VerticalLayout {
            spacing: 3px;
            vertical-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                color: AppTheme.text;
                font-size: 22px;
                font-weight: 700;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: AppTheme.text-muted;
                font-size: 12px;
            }
        }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> icon: "";
    in property <string> title;
    in property <string> hint;

    height: 34px;
    HorizontalLayout {
        spacing: 9px;
        cross-axis-alignment: center;
        if root.icon != "": Rectangle {
            width: 22px;
            height: 22px;
            background: transparent;
            Icon {
                name: root.icon;
                tint: AppTheme.accent-color;
                x: 2px;
                y: 2px;
            }
        }
        Text {
            text: root.title;
            color: AppTheme.text-secondary;
            font-size: 14px;
            font-weight: 650;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.hint != "": Text {
            text: root.hint;
            color: AppTheme.accent-color;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: AppTheme.line;
}

component AvailabilityHint inherits Text {
    text: "Not available yet";
    color: AppTheme.accent-color;
    font-size: 11px;
}

component EmptyState inherits Rectangle {
    in property <string> icon: "tablet";
    in property <bool> centered: true;
    in property <string> heading;
    in property <string> message;
    in property <string> detail;
    in property <string> primary-label;
    in property <string> secondary-label;
    callback primary-clicked();
    callback secondary-clicked();

    background: AppTheme.canvas;

    VerticalLayout {
        padding-left: root.centered ? 0px : 34px;
        padding-right: root.centered ? 0px : 34px;
        padding-top: root.centered ? 0px : 27px;
        alignment: root.centered ? center : start;
        cross-axis-alignment: root.centered ? center : start;
        spacing: 10px;

        Rectangle {
            width: 46px;
            height: 46px;
            border-radius: 23px;
            background: AppTheme.surface-alt;
            Icon {
                name: root.icon;
                tint: AppTheme.accent-color;
                x: 14px;
                y: 14px;
            }
        }

        Text {
            text: root.heading;
            color: AppTheme.text;
            font-size: 21px;
            font-weight: 700;
            horizontal-alignment: root.centered ? center : left;
        }
        Text {
            text: root.message;
            color: AppTheme.text-secondary;
            font-size: 14px;
            horizontal-alignment: root.centered ? center : left;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: AppTheme.text-muted;
            font-size: 12px;
            horizontal-alignment: root.centered ? center : left;
        }
        Rectangle { height: 7px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            if root.primary-label != "": AppButton {
                label: root.primary-label;
                primary: true;
                clicked => { root.primary-clicked(); }
            }
            if root.secondary-label != "": AppButton {
                label: root.secondary-label;
                primary: false;
                clicked => { root.secondary-clicked(); }
            }
        }
    }
}

component DeviceAction inherits Rectangle {
    in property <string> icon: "";
    in property <string> label;
    callback clicked();

    width: 300px;
    height: 46px;
    border-radius: 12px;
    background: touch.pressed ? AppTheme.accent-soft : (touch.has-hover ? AppTheme.surface-alt : AppTheme.surface);
    border-width: 1px;
    border-color: AppTheme.line;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;
        if root.icon != "": Icon {
            name: root.icon;
            tint: AppTheme.accent-color;
            width: 20px;
            height: 20px;
        }
        Text {
            text: root.label;
            color: AppTheme.text-secondary;
            font-size: 13px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: ">";
            color: AppTheme.text-muted;
            font-size: 16px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component DeviceOverview inherits Rectangle {
    in property <string> device-name;
    in property <string> active-profile;
    callback configure-area();
    callback open-pen();
    callback open-bindings();

    background: AppTheme.canvas;

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 8px;

        Text {
            text: root.device-name;
            color: AppTheme.text;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if root.active-profile != "": Text {
            text: "Active profile  /  " + root.active-profile;
            color: AppTheme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
        }
        Rectangle { height: 18px; }
        DeviceAction {
            icon: "area";
            label: "Configure area";
            clicked => { root.configure-area(); }
        }
        DeviceAction {
            icon: "pen";
            label: "Pen";
            clicked => { root.open-pen(); }
        }
        DeviceAction {
            icon: "buttons";
            label: "Bindings";
            clicked => { root.open-bindings(); }
        }
    }
}

component ValueRow inherits Rectangle {
    in property <string> icon: "";
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> interactive: false;
    in property <bool> show-chevron: false;
    callback clicked();

    height: AppTheme.row-height;
    opacity: root.enabled ? 1.0 : 0.43;
    background: touch.pressed && root.enabled && root.interactive ? AppTheme.accent-soft : (touch.has-hover && root.enabled && root.interactive ? AppTheme.surface-alt : transparent);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;
        if root.icon != "": Icon {
            name: root.icon;
            tint: root.enabled ? AppTheme.icon : #687481;
            width: 20px;
            height: 20px;
        }
        Text {
            text: root.label;
            color: AppTheme.text-secondary;
            font-size: 13px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        if root.value != "": Text {
            text: root.value;
            color: AppTheme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.show-chevron && root.interactive: Text {
            text: ">";
            color: AppTheme.text-muted;
            font-size: 16px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { root.clicked(); }
    }
}

component SwitchVisual inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;

    width: 42px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? AppTheme.accent-color : #2b333c;
    border-width: 1px;
    border-color: root.checked ? AppTheme.accent-color : #47525e;
    opacity: root.enabled ? 1.0 : 0.55;

    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? AppTheme.accent-on : #aab4c0;
        animate x { duration: AppTheme.reduce-motion ? 0ms : 120ms; }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> icon: "";
    in property <string> label;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    height: root.description == "" ? AppTheme.row-height : (AppTheme.compact ? 56px : 62px);
    opacity: root.enabled ? 1.0 : 0.43;
    background: touch.pressed && root.enabled ? AppTheme.accent-soft : (touch.has-hover && root.enabled ? AppTheme.surface-alt : transparent);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        cross-axis-alignment: center;
        if root.icon != "": Icon {
            name: root.icon;
            tint: root.enabled ? AppTheme.icon : #687481;
            width: 20px;
            height: 20px;
        }
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            alignment: center;
            cross-axis-alignment: start;
            Text {
                text: root.label;
                color: AppTheme.text-secondary;
                font-size: 13px;
            }
            if root.description != "": Text {
                text: root.description;
                color: AppTheme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        SwitchVisual {
            checked: root.checked;
            enabled: root.enabled;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}

component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    height: AppTheme.compact ? 30px : 32px;
    width: 76px;
    opacity: root.enabled ? 1.0 : 0.43;
    border-radius: 9px;
    background: root.selected ? (touch.pressed ? AppTheme.accent-pressed : AppTheme.accent-soft) : (touch.pressed && root.enabled ? #303a46 : (touch.has-hover && root.enabled ? #252d35 : transparent));
    border-width: root.selected ? 1px : 0px;
    border-color: AppTheme.accent-color;

    Text {
        text: root.label;
        color: root.selected ? AppTheme.text : #b5c0cb;
        font-size: 12px;
        font-weight: root.selected ? 650 : 450;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SectionTabs inherits Rectangle {
    in property <string> active-tab;
    callback select-tab(string);

    height: 34px;
    HorizontalLayout {
        spacing: 2px;
        SegmentButton {
            label: "Installed";
            selected: root.active-tab == "Installed";
            enabled: true;
            clicked => { root.select-tab("Installed"); }
        }
        SegmentButton {
            label: "Available";
            selected: root.active-tab == "Available";
            enabled: true;
            clicked => { root.select-tab("Available"); }
        }
    }
}

component ColorOption inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    width: 25px;
    height: 25px;
    border-radius: 13px;
    background: root.swatch;
    opacity: root.enabled ? (touch.pressed ? 0.75 : 1.0) : 0.42;
    border-width: root.selected ? 3px : 1px;
    border-color: root.selected ? AppTheme.accent-color : AppTheme.line;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component LinkButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 52px;
    height: 28px;
    border-radius: 7px;
    background: touch.pressed ? AppTheme.accent-soft : (touch.has-hover ? AppTheme.surface-alt : transparent);

    Text {
        text: root.label;
        color: AppTheme.accent-color;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component AreaPreview inherits Rectangle {
    in property <bool> has-data;

    min-width: 340px;
    height: 292px;
    border-radius: 14px;
    background: AppTheme.surface;
    border-width: 1px;
    border-color: AppTheme.line;

    Rectangle {
        x: 30px;
        y: 30px;
        width: parent.width - 60px;
        height: parent.height - 60px;
        border-radius: 10px;
        background: AppTheme.surface-alt;
        border-width: 1px;
        border-color: AppTheme.line;

        Text {
            text: "TABLET AREA";
            x: 14px;
            y: 12px;
            color: AppTheme.text-muted;
            font-size: 10px;
            font-weight: 700;
        }
        if root.has-data: Rectangle {
            x: 55px;
            y: 48px;
            width: parent.width - 110px;
            height: parent.height - 96px;
            border-radius: 7px;
            background: AppTheme.accent-soft;
            border-width: 2px;
            border-color: AppTheme.accent-color;
            Text {
                text: "ACTIVE AREA";
                color: AppTheme.accent-color;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        if !root.has-data: Text {
            text: "Area data unavailable";
            color: AppTheme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }

    Text {
        text: root.has-data ? "Drag & resize" : "Not available yet";
        color: AppTheme.text-muted;
        font-size: 11px;
        horizontal-alignment: center;
        x: 0px;
        y: parent.height - 23px;
        width: parent.width;
    }
}

component AreaEditor inherits Rectangle {
    in property <string> device-name;
    in property <bool> has-data;
    in property <string> area-width;
    in property <string> area-height;
    in property <string> area-x;
    in property <string> area-y;
    in property <string> area-rotation;
    property <bool> lock-aspect: false;
    callback retry-detection();

    background: AppTheme.canvas;

    VerticalLayout {
        padding-left: 34px;
        padding-right: 34px;
        padding-top: 27px;
        padding-bottom: 27px;
        spacing: 17px;

        PageHeader {
            icon: "area";
            title: "Area";
            subtitle: root.device-name;
        }

        HorizontalLayout {
            spacing: 20px;
            vertical-stretch: 1;

            AreaPreview {
                has-data: root.has-data;
                horizontal-stretch: 3;
            }

            Rectangle {
                horizontal-stretch: 2;
                VerticalLayout {
                    spacing: 3px;
                    SectionHeader {
                        icon: "area";
                        title: "Active area";
                        hint: root.has-data ? "" : "Not available yet";
                    }
                    ValueRow { icon: "width"; label: "Width"; value: root.has-data ? root.area-width : "-"; enabled: root.has-data; }
                    Divider {}
                    ValueRow { icon: "height"; label: "Height"; value: root.has-data ? root.area-height : "-"; enabled: root.has-data; }
                    Divider {}
                    ValueRow { icon: "x"; label: "X"; value: root.has-data ? root.area-x : "-"; enabled: root.has-data; }
                    Divider {}
                    ValueRow { icon: "y"; label: "Y"; value: root.has-data ? root.area-y : "-"; enabled: root.has-data; }
                    Divider {}
                    ValueRow { icon: "rotation"; label: "Rotation"; value: root.has-data ? root.area-rotation : "-"; enabled: root.has-data; }
                    Divider {}
                    SwitchRow {
                        icon: "lock";
                        label: "Lock aspect ratio";
                        description: "Keep width and height proportional";
                        checked: root.lock-aspect;
                        enabled: root.has-data;
                        toggled => { root.lock-aspect = !root.lock-aspect; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton { label: "Center"; primary: false; enabled: false; }
                        AppButton { label: "Full area"; primary: false; enabled: false; }
                        AppButton { label: "Apply"; primary: true; enabled: false; }
                    }
                    AvailabilityHint {}
                    Rectangle { vertical-stretch: 1; }
                    AppButton {
                        label: "Retry detection";
                        primary: false;
                        enabled: true;
                        clicked => { root.retry-detection(); }
                    }
                }
            }
        }
    }
}

component AreaPage inherits Rectangle {
    in property <string> backend-state;
    in property <string> device-name;
    in property <string> area-width;
    in property <string> area-height;
    in property <string> area-x;
    in property <string> area-y;
    in property <string> area-rotation;
    callback retry-detection();

    if root.backend-state == "ready" && root.device-name != "": AreaEditor {
        device-name: root.device-name;
        has-data: root.area-width != "" && root.area-height != "";
        area-width: root.area-width;
        area-height: root.area-height;
        area-x: root.area-x;
        area-y: root.area-y;
        area-rotation: root.area-rotation;
        retry-detection => { root.retry-detection(); }
    }
    if root.backend-state != "ready" || root.device-name == "": EmptyState {
        icon: "area";
        centered: false;
        heading: "Area";
        message: root.backend-state == "daemon-not-running" ? "OpenTabletDriver is not running" : (root.backend-state == "daemon-starting" ? "Starting OpenTabletDriver" : (root.backend-state == "daemon-running" ? "Waiting for tablet detection" : (root.backend-state == "unknown" ? "Waiting for tablet detection" : "No tablet connected")));
        detail: root.backend-state == "daemon-not-running" ? "Start OpenTabletDriver to detect a tablet." : (root.backend-state == "daemon-starting" ? "Retry in a moment." : "Connect a tablet to configure its active area.");
        primary-label: "";
        secondary-label: "Retry detection";
        secondary-clicked => { root.retry-detection(); }
    }
}

