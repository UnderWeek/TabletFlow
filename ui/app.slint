        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "test": Rectangle {
        x: 8px;
        y: 3px;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.name == "home" || root.name == "general": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
