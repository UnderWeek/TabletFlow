        spacing: 15px;

        PageHeader { icon: "profiles"; title: "Profiles"; subtitle: "Configuration profiles"; }
        SectionHeader { icon: "profiles"; title: "Profiles"; hint: "Not available yet"; }
        Rectangle {
            height: 82px;
            border-radius: 10px;
            background: AppTheme.surface;
            border-width: 1px;
