        width: 10px;
        height: 10px;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.tint;
        background: transparent;
    }
    if root.name == "logo": Rectangle {
        x: 3px;
        y: 3px;
        width: 12px;
