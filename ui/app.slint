}

// A compact nested setting. Its height is animated so the option feels attached
// to the parent switch instead of appearing as an unrelated new row.
component StartupSubsetting inherits Rectangle {
    in property <bool> expanded;
    in-out property <bool> start-minimized;
    callback changed();

    // This row has a two-line description, so it needs the same height as a
    // descriptive SwitchRow. Using the single-line row height clipped the
    // selection background and made the toggle feel vertically misaligned.
    height: root.expanded ? (AppTheme.compact ? 56px : 62px) : 0px;
    opacity: root.expanded ? 1.0 : 0.0;
    clip: true;
    animate height { duration: AppTheme.reduce-motion ? 0ms : 180ms; }
    animate opacity { duration: AppTheme.reduce-motion ? 0ms : 120ms; }

    HorizontalLayout {
        padding-left: 36px;
        padding-right: 0px;
        SwitchRow {
            icon: "minimized";
            label: "Start minimized";
            description: "Open TabletFlow in the background";
            checked: root.start-minimized;
            enabled: root.expanded;
            horizontal-stretch: 1;
            toggled => { root.start-minimized = !root.start-minimized; root.changed(); }
        }
    }
}

component SettingsPage inherits Rectangle {
    in property <string> backend-state;
    in-out property <string> theme: "System";
    in-out property <string> accent: "Blue";
    in-out property <bool> compact-ui: false;
    in-out property <bool> reduce-animations: false;
    in-out property <bool> start-with-system: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> close-to-tray: false;
    in-out property <bool> check-updates: true;
    in-out property <bool> pause-hidden: true;
    in-out property <bool> disable-unfocused-animations: false;
    in-out property <string> polling-interval: "Auto";
    in-out property <bool> low-power-mode: false;
    in-out property <bool> show-diagnostics: false;
    callback open-github();
    callback settings-changed();

    background: AppTheme.canvas;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: 1290px;

        HorizontalLayout {
            width: parent.width;
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                width: parent.width < 840px ? parent.width : 840px;
                padding-left: 34px;
                padding-right: 34px;
                padding-top: 26px;
                padding-bottom: 30px;
                spacing: 3px;

            PageHeader { icon: "settings"; title: "Settings"; subtitle: "TabletFlow"; }

            Rectangle { height: 13px; }
            SectionHeader { icon: "theme"; title: "Appearance"; hint: "Applied instantly"; }
            HorizontalLayout {
                height: AppTheme.row-height;
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;
                Icon { name: "theme"; tint: AppTheme.icon; width: 20px; height: 20px; }
                Text { text: "Theme"; color: AppTheme.text-secondary; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                SegmentButton { label: "System"; selected: root.theme == "System"; enabled: true; clicked => { root.theme = "System"; AppTheme.mode = "system"; root.settings-changed(); } }
                SegmentButton { label: "Light"; selected: root.theme == "Light"; enabled: true; clicked => { root.theme = "Light"; AppTheme.mode = "light"; root.settings-changed(); } }
                SegmentButton { label: "Dark"; selected: root.theme == "Dark"; enabled: true; clicked => { root.theme = "Dark"; AppTheme.mode = "dark"; root.settings-changed(); } }
            }
            HorizontalLayout {
                height: AppTheme.row-height;
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;
                Icon { name: "accent"; tint: AppTheme.icon; width: 20px; height: 20px; }
                Text { text: "Accent color"; color: AppTheme.text-secondary; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                ColorOption { swatch: #8fb5e6; selected: root.accent == "Blue"; enabled: true; clicked => { root.accent = "Blue"; AppTheme.accent = "Blue"; root.settings-changed(); } }
                ColorOption { swatch: #d6aa72; selected: root.accent == "Amber"; enabled: true; clicked => { root.accent = "Amber"; AppTheme.accent = "Amber"; root.settings-changed(); } }
                ColorOption { swatch: #9ac7b0; selected: root.accent == "Mint"; enabled: true; clicked => { root.accent = "Mint"; AppTheme.accent = "Mint"; root.settings-changed(); } }
            }
            Divider {}
            SwitchRow { icon: "compact"; label: "Compact UI"; description: "Use tighter spacing throughout TabletFlow"; checked: root.compact-ui; enabled: true; toggled => { root.compact-ui = !root.compact-ui; AppTheme.compact = root.compact-ui; root.settings-changed(); } }
            SwitchRow { icon: "reduce"; label: "Reduce animations"; description: "Prefer instant transitions"; checked: root.reduce-animations; enabled: true; toggled => { root.reduce-animations = !root.reduce-animations; AppTheme.reduce-motion = root.reduce-animations; root.settings-changed(); } }

            Rectangle { height: 17px; }
            SectionHeader { icon: "general"; title: "General"; hint: "Applied instantly"; }
            SwitchRow {
                icon: "startup";
                label: "Start with system";
                description: "Open TabletFlow when you sign in";
                checked: root.start-with-system;
                enabled: true;
                toggled => { root.start-with-system = !root.start-with-system; root.settings-changed(); }
            }
            StartupSubsetting {
                expanded: root.start-with-system;
                start-minimized <=> root.start-minimized;
                changed => { root.settings-changed(); }
            }
            SwitchRow {
                icon: "close";
                label: "Close to tray";
                description: "Keep TabletFlow available from the menu bar";
                checked: root.close-to-tray;
                enabled: true;
                toggled => { root.close-to-tray = !root.close-to-tray; root.settings-changed(); }
            }
            SwitchRow {
                icon: "updates";
                label: "Check for updates";
                description: "Notify when a new version is available";
                checked: root.check-updates;
                enabled: true;
                toggled => { root.check-updates = !root.check-updates; root.settings-changed(); }
            }

            Rectangle { height: 17px; }
            SectionHeader { icon: "plugins"; title: "OpenTabletDriver"; hint: "Embedded daemon"; }
            ValueRow {
                icon: "connection";
                label: "Connection status";
                value: root.backend-state == "unknown" ? "-" : (root.backend-state == "daemon-not-running" ? "Not running" : (root.backend-state == "daemon-starting" ? "Starting" : (root.backend-state == "daemon-running" ? "Waiting for tablet" : (root.backend-state == "no-tablet" ? "No tablet" : "Connected"))));
                enabled: false;
            }

            Rectangle { height: 17px; }
            SectionHeader { icon: "performance"; title: "Performance"; hint: "Not available yet"; }
            SwitchRow { icon: "pause"; label: "Pause UI updates when hidden"; checked: root.pause-hidden; enabled: false; }
            SwitchRow { icon: "focus"; label: "Disable animations when unfocused"; checked: root.disable-unfocused-animations; enabled: false; }
            HorizontalLayout {
                height: AppTheme.row-height;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                cross-axis-alignment: center;
                Icon { name: "polling"; tint: AppTheme.icon; width: 20px; height: 20px; }
                Text { text: "Background polling interval"; color: AppTheme.text-secondary; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                SegmentButton { label: "Auto"; selected: root.polling-interval == "Auto"; enabled: false; }
                SegmentButton { label: "Low"; selected: root.polling-interval == "Low"; enabled: false; }
                SegmentButton { label: "High"; selected: root.polling-interval == "High"; enabled: false; }
            }
            SwitchRow { icon: "power"; label: "Low power mode"; checked: root.low-power-mode; enabled: false; }

            Rectangle { height: 17px; }
            SectionHeader { icon: "advanced"; title: "Advanced"; hint: "Not available yet"; }
            SwitchRow { icon: "diagnostics"; label: "Show diagnostics"; checked: root.show-diagnostics; enabled: false; }
            ValueRow { icon: "config"; label: "Open config directory"; value: "Not available yet"; enabled: false; }
            ValueRow {
                icon: "reset";
                label: "Reset TabletFlow settings";
                value: "Reset";
                enabled: true;
                interactive: true;
                show-chevron: true;
                clicked => {
                    root.theme = "System";
                    root.accent = "Blue";
                    AppTheme.mode = "system";
                    AppTheme.accent = "Blue";
                    root.compact-ui = false;
                    root.reduce-animations = false;
                    AppTheme.compact = false;
                    AppTheme.reduce-motion = false;
                    root.start-with-system = false;
                    root.start-minimized = false;
                    root.close-to-tray = false;
                    root.check-updates = true;
                    root.pause-hidden = true;
                    root.disable-unfocused-animations = false;
                    root.polling-interval = "Auto";
                    root.low-power-mode = false;
                    root.show-diagnostics = false;
                    root.settings-changed();
                }
            }

            Rectangle { height: 20px; }
            Divider {}
                HorizontalLayout {
                    height: 38px;
                    padding-left: 12px;
                    padding-right: 12px;
                    Text { text: "TabletFlow 0.1.0"; color: AppTheme.text-muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: "OpenTabletDriver: version unavailable"; color: AppTheme.text-muted; font-size: 11px; vertical-alignment: center; }
                    LinkButton { label: "GitHub"; clicked => { root.open-github(); } }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

component SectionPage inherits Rectangle {
    in property <string> page-title;
    in property <string> message;

    background: AppTheme.canvas;
    VerticalLayout {
        padding-left: 34px;
        padding-right: 34px;
        padding-top: 27px;
        padding-bottom: 27px;
        spacing: 12px;
        PageHeader { icon: root.page-title == "Bindings" ? "buttons" : ""; title: root.page-title; subtitle: ""; }
        if root.message != "": Text {
            text: root.message;
            color: AppTheme.text-muted;
            font-size: 13px;
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("tray.svg");
    tooltip: "TabletFlow";
    title: "TabletFlow";
    in-out property <bool> shown: true;
    visible: root.shown;

    callback open();
    callback quit();

    Menu {
        MenuItem {
            title: "Open TabletFlow";
            activated => { root.open(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

// Backend state contract: "unknown", "daemon-not-running", "daemon-starting", "daemon-running", "no-tablet", "ready".
// The default stays unknown until real IPC data is provided by the backend.
export component MainWindow inherits Window {
    title: "TabletFlow";
    preferred-width: 960px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 500px;

    in-out property <string> active-page: "Overview";
    in-out property <string> backend-state: "unknown";
    in-out property <string> device-name: "";
    in-out property <string> active-profile: "";
    in-out property <string> area-width: "";
    in-out property <string> area-height: "";
    in-out property <string> area-x: "";
    in-out property <string> area-y: "";
    in-out property <string> area-rotation: "";
    in-out property <bool> pen-data-available: false;
    in-out property <string> theme: "System";
    in-out property <string> accent: "Blue";
    in-out property <bool> compact-ui: false;
    in-out property <bool> reduce-animations: false;
    in-out property <bool> start-with-system: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> close-to-tray: false;
    in-out property <bool> check-updates: true;
    in-out property <bool> pause-hidden: true;
    in-out property <bool> disable-unfocused-animations: false;
    in-out property <string> polling-interval: "Auto";
    in-out property <bool> low-power-mode: false;
    in-out property <bool> show-diagnostics: false;

    callback navigate(string);
    callback start-daemon();
    callback retry-backend();
    callback open-github();
    callback settings-changed();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: AppTheme.canvas;

        HorizontalLayout {
            spacing: 0px;
            Sidebar {
                active-page: root.active-page;
                navigate(page) => { root.navigate(page); }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: AppTheme.canvas;

                if root.active-page == "Overview" && root.backend-state == "daemon-not-running": EmptyState {
                    icon: "daemon";
                    heading: "TabletFlow";
                    message: "OpenTabletDriver is not running";
                    detail: "";
                    primary-label: "Start daemon";
                    secondary-label: "Retry";
                    primary-clicked => { root.start-daemon(); }
                    secondary-clicked => { root.retry-backend(); }
                }
                if root.active-page == "Overview" && root.backend-state == "no-tablet": EmptyState {
                    icon: "tablet";
                    heading: "TabletFlow";
                    message: "No tablet detected";
                    detail: "Connect a supported tablet.";
                    primary-label: "";
                    secondary-label: "Retry";
                    secondary-clicked => { root.retry-backend(); }
                }
                if root.active-page == "Overview" && root.backend-state == "daemon-starting": EmptyState {
                    icon: "daemon";
                    heading: "TabletFlow";
                    message: "Starting OpenTabletDriver";
                    detail: "Retry in a moment.";
                    primary-label: "";
                    secondary-label: "Retry";
                    secondary-clicked => { root.retry-backend(); }
                }
                if root.active-page == "Overview" && root.backend-state == "ready" && root.device-name != "": DeviceOverview {
                    device-name: root.device-name;
                    active-profile: root.active-profile;
                    configure-area => { root.navigate("Area"); }
                    open-pen => { root.navigate("Pen"); }
                    open-bindings => { root.navigate("Bindings"); }
                }
                if root.active-page == "Overview"
                    && (root.backend-state == "unknown"
                        || root.backend-state == "daemon-running"
                        || (root.backend-state == "ready" && root.device-name == "")): EmptyState {
                    icon: root.backend-state == "daemon-running" ? "tablet" : "daemon";
                    heading: "TabletFlow";
                    message: root.backend-state == "daemon-running" ? "Waiting for tablet detection" : "Waiting for OpenTabletDriver";
                    detail: root.backend-state == "daemon-running" ? "Connect a supported tablet." : "Connect OpenTabletDriver to continue.";
                    primary-label: "";
                    secondary-label: "Retry";
                    secondary-clicked => { root.retry-backend(); }
                }

                if root.active-page == "Area": AreaPage {
                    backend-state: root.backend-state;
                    device-name: root.device-name;
                    area-width: root.area-width;
                    area-height: root.area-height;
                    area-x: root.area-x;
                    area-y: root.area-y;
                    area-rotation: root.area-rotation;
                    retry-detection => { root.retry-backend(); }
                }
                if root.active-page == "Pen": PenPage {
                    backend-state: root.backend-state;
                    device-name: root.device-name;
                    pen-data-available: root.pen-data-available;
                    retry-detection => { root.retry-backend(); }
                }
                if root.active-page == "Plugins": PluginsPage {}
                if root.active-page == "Profiles": ProfilesPage {}
                if root.active-page == "Settings": SettingsPage {
                    backend-state: root.backend-state;
                    theme <=> root.theme;
                    accent <=> root.accent;
                    compact-ui <=> root.compact-ui;
                    reduce-animations <=> root.reduce-animations;
                    start-with-system <=> root.start-with-system;
                    start-minimized <=> root.start-minimized;
                    close-to-tray <=> root.close-to-tray;
                    check-updates <=> root.check-updates;
                    pause-hidden <=> root.pause-hidden;
                    disable-unfocused-animations <=> root.disable-unfocused-animations;
                    polling-interval <=> root.polling-interval;
                    low-power-mode <=> root.low-power-mode;
                    show-diagnostics <=> root.show-diagnostics;
                    open-github => { root.open-github(); }
                    settings-changed => { root.settings-changed(); }
                }
                if root.active-page == "Bindings": SectionPage {
                    page-title: "Bindings";
                    message: root.backend-state == "unknown" ? "" : (root.backend-state == "daemon-not-running" ? "OpenTabletDriver is not running" : (root.backend-state == "daemon-running" ? "Waiting for tablet detection" : (root.backend-state == "no-tablet" ? "Connect a tablet to continue." : "")));
                }
            }
        }
    }
}
