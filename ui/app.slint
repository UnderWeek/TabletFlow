    if root.name == "width" || root.name == "height" || root.name == "x" || root.name == "y" || root.name == "rotation" || root.name == "lock" || root.name == "sensitivity" || root.name == "disable-pressure" || root.name == "buttons" || root.name == "button1" || root.name == "button2" || root.name == "test" || root.name == "polling" || root.name == "power" || root.name == "diagnostics": Rectangle {
        x: 3px;
